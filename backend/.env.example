# ============================================================
# WhyBadAQI Backend — Environment Configuration Template
# Copy this to .env and fill in your real keys.
# NEVER commit .env to version control!
# ============================================================

# --- JWT Authentication ---
JWT_SECRET=replace_with_strong_random_secret_min_32_chars

# --- Database (choose one) ---
# MongoDB Atlas connection string:
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=whybadaqi
# SQLite fallback used automatically when MongoDB is not reachable.
SQLITE_PATH=whybadaqi.db

# --- External Data APIs (all optional — simulator kicks in if missing) ---
# OpenAQ v3 — free tier at https://explore.openaq.org/
OPENAQ_API_KEY=

# OpenWeatherMap — free at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# NASA FIRMS MAP Key — free at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# --- AWS (only needed for cloud deployment via infra/template.yaml) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Expo Push Notifications (EAS / expo-notifications) ---
EXPO_PUSH_NOTIFICATION_TOKEN=
